# Copia este archivo a ".env" (que ya esta en .gitignore) y rellena los
# valores reales. Nunca commitees el ".env" con valores reales.
#
# docker-compose lee este archivo automaticamente si se llama ".env".

# ── URL publica del frontend (para el QR y enlaces similares) ─
APP_FRONTEND_URL=http://localhost:4200

# ── Base de datos ──────────────────────────────────────────
DB_PASSWORD=cambia_esto_por_una_contrasena_fuerte
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/SCAPAV2
SPRING_DATASOURCE_USERNAME=postgres

# ── JWT ─────────────────────────────────────────────────────
# Genera uno nuevo con: openssl rand -hex 32
# El valor anterior quedo expuesto en el historial de git publico del
# repositorio: no lo reutilices, genera uno distinto.
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_32_bytes

# ── Correo (notificaciones de alertas) ─────────────────────
# La contrasena de aplicacion anterior tambien quedo expuesta y fue
# revocada. Genera una nueva en https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=tu_correo@gmail.com
SPRING_MAIL_PASSWORD=tu_nueva_contrasena_de_aplicacion

# ── Cloudinary (documentos de lote) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Proveedores de IA (motor de sugerencias) ───────────────
GEMINI_API_KEY=
GROQ_API_KEY=
